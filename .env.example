# Conexión a PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL="postgresql://comandas:comandas_dev@localhost:5433/comandas?schema=public"

# Secreto para firmar los JWT (mínimo 32 caracteres). Generar con: openssl rand -hex 32
JWT_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"
PORT=3000

# Origen del frontend (CORS). En desarrollo también se aceptan IPs 192.168.x.x
FRONTEND_URL="http://localhost:5173"

# Proxies de confianza, para que el límite de intentos de login use la IP real
# del cliente. Vacío en desarrollo; en Railway va "1" (un proxy delante)
TRUST_PROXY=
