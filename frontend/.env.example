# URL del backend, sin barra final. Vacío = mismo origen: en desarrollo Vite
# reenvía /api, /uploads y /socket.io al backend, y así funciona también desde
# el celular. En producción, si el backend vive en otro dominio:
# VITE_API_URL="https://api.midominio.com"
VITE_API_URL=

# Solo desarrollo: a dónde reenvía Vite las rutas del backend
PROXY_BACKEND="http://localhost:3000"
