# URL del backend, sin barra final. Vacío = mismo origen, que es lo normal:
# en desarrollo Vite reenvía /api y /socket.io al backend (así funciona también
# desde el celular) y en producción el backend sirve este frontend.
# Solo si el backend viviera en otro dominio: VITE_API_URL="https://api.midominio.com"
VITE_API_URL=

# Solo desarrollo: a dónde reenvía Vite las rutas del backend
PROXY_BACKEND="http://localhost:3000"
