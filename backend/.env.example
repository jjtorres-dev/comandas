# Variables del backend. En desarrollo: copia este archivo a .env.
# En producción (Railway) se definen en el panel del servicio, no en un archivo;
# ahí TODAS son obligatorias y el servidor no arranca si falta alguna.

# Conexión a PostgreSQL. En desarrollo coincide con docker-compose.yml.
# En Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://comandas:comandas_dev@localhost:5433/comandas?schema=public"

# Secreto para firmar las sesiones (mínimo 32 caracteres). Cada instalación usa
# el suyo: genera uno con `openssl rand -hex 32`. Con este de ejemplo, producción no arranca.
JWT_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"

# development, test o production. La imagen de Docker ya trae "production"
NODE_ENV=development

# Puerto del servidor. Railway lo define solo
PORT=3000

# Proxies de confianza: de ahí sale la IP real de cada equipo para los límites
# de intentos. Vacío en desarrollo; en Railway va "1" (hay un proxy delante)
TRUST_PROXY=

# ---------- Solo desarrollo ----------

# Origen del frontend (CORS). También se aceptan IPs 192.168.x.x. En producción
# no hay CORS: el backend sirve el frontend desde el mismo origen
FRONTEND_URL="http://localhost:5173"

# ---------- Opcionales ----------

# Carpeta del build del frontend que sirve el backend en producción
# (por defecto ../frontend/dist)
# FRONTEND_DIST=

# Detalle de los registros: fatal, error, warn, info, debug, trace o silent
# (por defecto info en producción y warn en desarrollo)
# LOG_LEVEL=

# ---------- Solo para `npm run seed:produccion` ----------
# El primer usuario (dueño, cocina y caja). Solo se usa si el negocio no tiene
# ningún usuario; después se pueden borrar de las variables
# ADMIN_INICIAL_NOMBRE="Colver Falcón"
# ADMIN_INICIAL_USUARIO="colver"
# ADMIN_INICIAL_PASSWORD="una-contraseña-de-8-o-más"
