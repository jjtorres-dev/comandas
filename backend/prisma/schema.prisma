// ============================================================
//  Sistema de comandas para restaurantes / cevicherías / pollerías
//  Modelo de datos MVP — PostgreSQL + Prisma
//  Multi-negocio desde el inicio: todo cuelga de `negocioId`
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // El backend se compila con tsc a ESM de Node: los imports llevan ".js"
  importFileExtension = "js"
}

// La URL de conexión vive en prisma.config.ts (Prisma 7)
datasource db {
  provider = "postgresql"
}

// ---------- ENUMS ----------

enum Rol {
  ADMIN // dueño: carta, precios, mesas, usuarios, reportes
  MOZO // toma pedidos desde el celular
  LOCAL // panel de cocina + caja (en este local, la misma persona)
}

enum TipoPedido {
  MESA
  DELIVERY
  PARA_LLEVAR
}

enum EstadoPedido {
  PENDIENTE // recién enviado
  PREPARANDO // cocina lo empezó
  LISTO // todo listo para servir / despachar
  EN_CAMINO // solo delivery: salió con el motorizado
  ENTREGADO // en la mesa o entregado al cliente
  CANCELADO
}

enum EstadoItem {
  PENDIENTE
  PREPARANDO
  LISTO
  ENTREGADO
  CANCELADO
}

// ANTICIPADO: el cliente dice que ya pagó (Yape o Plin), queda por confirmar.
// AL_RECIBIR: paga cuando le llega el pedido (contraentrega) o cuando lo recoge.
enum MomentoPago {
  ANTICIPADO
  AL_RECIBIR
}

enum MetodoPago {
  EFECTIVO
  YAPE
  PLIN
  TARJETA
}

// ---------- NEGOCIO Y USUARIOS ----------

model Negocio {
  id        String   @id @default(uuid())
  codigo    String   @unique // identifica al negocio en el login, p. ej. "valentina"
  nombre    String
  ruc       String?
  telefono  String?
  direccion String?
  // Dirección desde la que se sirve el logo: "/api/negocios/<codigo>/logo?v=…"
  // (la imagen vive en `logo`), o una URL absoluta. null = sin logo
  logoUrl   String?
  // El logo se guarda en la base: sobrevive a cada despliegue sin disco propio
  logo      Bytes?
  logoTipo  String? // "image/png", "image/jpeg" o "image/webp"
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  // Valores sugeridos al crear un pedido; lo cobrado se copia al Pedido
  costoEnvioDefault Decimal @default(3.00) @db.Decimal(10, 2)
  precioTaper       Decimal @default(1.00) @db.Decimal(10, 2) // por cada taper

  // Reparto: distritos a los que llega el delivery (el primero es el de por
  // defecto) y la región que completa la dirección al buscarla en un mapa
  distritos String[] // ["Tarapoto", "Morales", "La Banda de Shilcayo"]
  region    String? // "San Martín, Perú"

  // Cocina: minutos a partir de los cuales una comanda "tarda" (ámbar) y va
  // "muy tarde" (rojo)
  umbralTardaMin    Int @default(15)
  umbralMuyTardeMin Int @default(25)

  usuarios     Usuario[]
  areas        Area[]
  categorias   Categoria[]
  productos    Producto[]
  notasRapidas NotaRapida[]
  mesas        Mesa[]
  clientes     Cliente[]
  repartidores Repartidor[]
  pedidos      Pedido[]
  turnosCaja   TurnoCaja[]
}

model Usuario {
  id           String   @id @default(uuid())
  negocioId    String
  nombre       String
  usuario      String // login corto, p. ej. "tia.rosa"
  passwordHash String
  roles        Rol[] // una persona puede tener varios roles
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  negocio        Negocio      @relation(fields: [negocioId], references: [id])
  pedidosTomados Pedido[]     @relation("MozoPedido")
  pagosCobrados  Pago[]       @relation("PagoCobradoPor")
  pagosAnulados  Pago[]       @relation("PagoAnuladoPor")
  cambiosDePago  PagoCambio[]
  turnosAbiertos TurnoCaja[]  @relation("TurnoAbiertoPor")
  turnosCerrados TurnoCaja[]  @relation("TurnoCerradoPor")

  @@unique([negocioId, usuario])
}

// ---------- CARTA ----------

// Área de preparación: "Cocina", o "Fría" / "Caliente" / "Bebidas" en locales grandes
model Area {
  id        String  @id @default(uuid())
  negocioId String
  nombre    String
  orden     Int     @default(0)
  activo    Boolean @default(true)

  negocio   Negocio      @relation(fields: [negocioId], references: [id])
  productos Producto[]
  items     PedidoItem[]
}

model Categoria {
  id        String  @id @default(uuid())
  negocioId String
  nombre    String // "Ceviches", "Chicharrones", "Bebidas"
  orden     Int     @default(0)
  activo    Boolean @default(true)

  negocio   Negocio    @relation(fields: [negocioId], references: [id])
  productos Producto[]
}

model Producto {
  id          String  @id @default(uuid())
  negocioId   String
  categoriaId String
  areaId      String
  nombre      String // "Ceviche de pescado"
  descripcion String?
  imagenUrl   String?
  orden       Int     @default(0)
  activo      Boolean @default(true)

  // Combos: "Dúo marino" = el cliente elige `comboCantidad` platos
  // de la lista de opciones elegibles
  // Tapers que ocupa una unidad al despacharla (delivery / para llevar):
  // 0 = bebidas, 1 = un plato, 2 o 3 = combos
  tapers Int @default(1)

  esCombo       Boolean @default(false)
  comboCantidad Int? // 2 = doble, 3 = triple (solo si esCombo)

  negocio   Negocio            @relation(fields: [negocioId], references: [id])
  categoria Categoria          @relation(fields: [categoriaId], references: [id])
  area      Area               @relation(fields: [areaId], references: [id])
  variantes VarianteProducto[]

  opcionesCombo ComboOpcion[] @relation("ComboOpciones") // si es combo: sus platos elegibles
  enCombos      ComboOpcion[] @relation("ComboProducto") // combos en los que se puede elegir
}

// Platos elegibles de un combo. Lo que el cliente elige se copia
// como texto en PedidoItem.componentes
model ComboOpcion {
  id         String @id @default(uuid())
  comboId    String
  productoId String
  orden      Int    @default(0)

  combo    Producto @relation("ComboOpciones", fields: [comboId], references: [id], onDelete: Cascade)
  producto Producto @relation("ComboProducto", fields: [productoId], references: [id])

  @@unique([comboId, productoId])
}

// Todo producto tiene al menos una variante (aunque sea "Única").
// Así el precio siempre vive aquí: "Personal" S/ 25, "Fuente" S/ 45
model VarianteProducto {
  id         String  @id @default(uuid())
  productoId String
  nombre     String
  precio     Decimal @db.Decimal(10, 2)
  orden      Int     @default(0)
  activo     Boolean @default(true)

  producto Producto     @relation(fields: [productoId], references: [id])
  items    PedidoItem[]
}

// Botones rápidos: "sin cebolla", "ají aparte", "con picante"
model NotaRapida {
  id        String  @id @default(uuid())
  negocioId String
  texto     String
  orden     Int     @default(0)
  activo    Boolean @default(true)

  negocio Negocio @relation(fields: [negocioId], references: [id])
}

// ---------- SALÓN Y DELIVERY ----------

model Mesa {
  id        String  @id @default(uuid())
  negocioId String
  nombre    String // "Mesa 1", "Terraza 2"
  orden     Int     @default(0)
  activo    Boolean @default(true)
  // ¿Ocupada? Se calcula: tiene un pedido no pagado y no cancelado

  negocio Negocio  @relation(fields: [negocioId], references: [id])
  pedidos Pedido[]
}

// Clientes de delivery: al escribir el teléfono se autocompletan los datos
model Cliente {
  id         String   @id @default(uuid())
  negocioId  String
  telefono   String
  nombre     String?
  direccion  String?
  distrito   String?
  referencia String?
  creadoEn   DateTime @default(now())

  negocio Negocio  @relation(fields: [negocioId], references: [id])
  pedidos Pedido[]

  @@unique([negocioId, telefono])
}

// Motorizado: no necesita usuario para entrar al sistema
model Repartidor {
  id        String  @id @default(uuid())
  negocioId String
  nombre    String
  telefono  String?
  activo    Boolean @default(true)

  negocio Negocio  @relation(fields: [negocioId], references: [id])
  pedidos Pedido[]
}

// ---------- PEDIDOS ----------

model Pedido {
  id        String       @id @default(uuid())
  negocioId String
  numero    Int // correlativo visible: "Pedido #23"
  tipo      TipoPedido
  estado    EstadoPedido @default(PENDIENTE)

  mesaId       String?
  mozoId       String?
  clienteId    String?
  repartidorId String?

  // Datos de entrega copiados al momento del pedido (si el cliente
  // cambia de dirección después, el historial no se altera)
  direccionEntrega  String?
  distritoEntrega   String?
  referenciaEntrega String?
  nombreCliente     String? // también para llevar: "pedido de Juan", sin teléfono
  telefonoCliente   String?
  costoEnvio        Decimal @default(0) @db.Decimal(10, 2)

  // Tapers: aplica a DELIVERY y PARA_LLEVAR
  cantidadTapers Int     @default(0)
  // true si alguien fijó la cantidad a mano: ya no se recalcula con los items
  tapersManual   Boolean @default(false)
  cargoTapers    Decimal @default(0) @db.Decimal(10, 2)

  // total = subtotal + costoEnvio + cargoTapers - descuento
  nota         String?
  subtotal     Decimal @default(0) @db.Decimal(10, 2)
  descuento    Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @default(0) @db.Decimal(10, 2)
  pagado       Boolean @default(false)
  // true si el pedido de mesa ya estuvo pagado y su cuenta se reabrió (se anuló
  // un pago): sigue debiendo, pero nunca vuelve a ocupar la mesa
  mesaLiberada Boolean @default(false)

  // Pago previsto (pedidos por teléfono): lo que el motorizado necesita saber.
  // No es un pago: el cobro entra a la caja cuando se confirma o se cobra.
  pagoMomento MomentoPago?
  pagoMetodo  MetodoPago?
  pagaCon     Decimal?     @db.Decimal(10, 2) // efectivo al recibir: con cuánto paga

  // Por qué se canceló el pedido entero (cuando se cancela desde Delivery)
  motivoCancelacion String?

  // Lo genera el celular del mozo: si se cae la señal y reintenta,
  // el servidor no crea el pedido dos veces
  idCliente String? @unique

  creadoEn    DateTime  @default(now())
  pagadoEn    DateTime?
  // Cuándo quedó ENTREGADO (null si no lo está). Deshacer una entrega solo se
  // permite si no se registró ningún pago desde entonces
  entregadoEn DateTime?

  negocio    Negocio      @relation(fields: [negocioId], references: [id])
  mesa       Mesa?        @relation(fields: [mesaId], references: [id])
  mozo       Usuario?     @relation("MozoPedido", fields: [mozoId], references: [id])
  cliente    Cliente?     @relation(fields: [clienteId], references: [id])
  repartidor Repartidor?  @relation(fields: [repartidorId], references: [id])
  items      PedidoItem[]
  pagos      Pago[]

  @@index([negocioId, estado])
  @@index([negocioId, creadoEn])
}

model PedidoItem {
  id         String     @id @default(uuid())
  pedidoId   String
  varianteId String
  areaId     String
  cantidad   Int        @default(1)
  estado     EstadoItem @default(PENDIENTE)
  orden      Int        @default(0) // posición en la comanda, en el orden en que se pidió

  // Lo genera el celular por cada ronda: si reintenta, no se duplican los items.
  // La primera ronda usa el idCliente del pedido
  idRonda String

  // Copias del momento del pedido: si mañana sube el precio,
  // los pedidos de hoy no cambian
  nombreProducto String // "Ceviche de pescado — Fuente"
  precioUnitario Decimal @db.Decimal(10, 2)

  notas String[] // ["sin cebolla", "ají aparte", "limón extra"]

  // Solo combos: platos elegidos, copiados como texto
  componentes String[] // ["Ceviche simple", "Chicharrón mixto"]

  creadoEn DateTime  @default(now()) // permite ver "rondas" agregadas después
  // Cuándo se marcó LISTO. Vuelve a null si regresa a PENDIENTE o PREPARANDO;
  // se conserva al pasar a ENTREGADO. El panel de cocina ordena "recién listos" con esto
  listoEn  DateTime?

  pedido   Pedido           @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  variante VarianteProducto @relation(fields: [varianteId], references: [id])
  area     Area             @relation(fields: [areaId], references: [id])

  @@index([areaId, estado])
  @@index([pedidoId, idRonda])
}

// ---------- CAJA ----------

// Un pedido puede tener varios pagos = pago mixto (Yape + efectivo)
model Pago {
  id          String     @id @default(uuid())
  pedidoId    String
  turnoCajaId String
  usuarioId   String
  metodo      MetodoPago
  monto       Decimal    @db.Decimal(10, 2)
  recibido    Decimal?   @db.Decimal(10, 2) // solo efectivo: para calcular el vuelto
  referencia  String? // nº de operación Yape/Plin o voucher
  itemIds     String[] // cuenta dividida: los PedidoItem que cubre este pago (vacío = a cuenta)
  // Cuenta dividida por unidades: { itemId: cantidad }. null en pagos antiguos
  // (ahí cada itemId cuenta por todas sus unidades)
  unidades    Json?
  // Los pagos de un mismo cobro (pago mixto) comparten grupo: sus items se
  // cuentan una sola vez
  grupoId     String     @default(uuid())
  creadoEn    DateTime   @default(now())

  // Un pago nunca se borra: se anula, y deja de contar en todos los totales
  anuladoEn       DateTime?
  anuladoPorId    String?
  motivoAnulacion String?

  pedido     Pedido       @relation(fields: [pedidoId], references: [id])
  turnoCaja  TurnoCaja    @relation(fields: [turnoCajaId], references: [id])
  usuario    Usuario      @relation("PagoCobradoPor", fields: [usuarioId], references: [id])
  anuladoPor Usuario?     @relation("PagoAnuladoPor", fields: [anuladoPorId], references: [id])
  cambios    PagoCambio[]

  @@index([turnoCajaId])
}

// Registro de toda corrección hecha a un pago (cambio de método o anulación)
model PagoCambio {
  id        String   @id @default(uuid())
  pagoId    String
  usuarioId String
  tipo      String // "METODO" | "ANULACION"
  // Qué había antes y qué quedó: { antes: {...}, despues: {...} } o { motivo }
  detalle   Json
  creadoEn  DateTime @default(now())

  pago    Pago    @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([pagoId])
}

// Apertura y cierre de caja del día
model TurnoCaja {
  id              String    @id @default(uuid())
  negocioId       String
  abiertoPorId    String
  cerradoPorId    String?
  montoInicial    Decimal   @default(0) @db.Decimal(10, 2) // sencillo con el que se abre
  efectivoContado Decimal?  @db.Decimal(10, 2) // lo que se cuenta al cerrar
  observacion     String?
  abiertoEn       DateTime  @default(now())
  cerradoEn       DateTime?
  // Totales por método se calculan sumando sus pagos

  negocio    Negocio  @relation(fields: [negocioId], references: [id])
  abiertoPor Usuario  @relation("TurnoAbiertoPor", fields: [abiertoPorId], references: [id])
  cerradoPor Usuario? @relation("TurnoCerradoPor", fields: [cerradoPorId], references: [id])
  pagos      Pago[]
}
